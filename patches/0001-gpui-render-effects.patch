+    /// Paint a runtime HLSL canvas in the current stacking context.
+    pub fn paint_gpu_canvas(&mut self, canvas: PaintGpuCanvas) {
+        self.invalidator.debug_assert_paint();
+
+        let scale_factor = self.scale_factor();
+        self.next_frame.scene.insert_primitive(GpuCanvas {
+            shader: canvas.shader,
+            primitive: GpuCanvasPrimitive {
+                order: 0,
+                shader_index: 0,
+                input: canvas.input,
+                _pad: 0,
+                bounds: self.snap_bounds(canvas.bounds),
+                content_mask: self.snapped_content_mask(),
+                opacity: canvas.opacity.clamp(0.0, 1.0) * self.element_opacity(),
+                scale_factor,
+                _meta_pad: [0; 2],
+                uniforms: canvas.uniforms,
+            },
+        });
+    }
+
+    /// Paint an element-local backdrop blur from the already rendered framebuffer.
+    pub fn paint_backdrop_blur(&mut self, blur: PaintBackdropBlur) {
+        self.invalidator.debug_assert_paint();
+
+        let scale_factor = self.scale_factor();
+        self.next_frame
+            .scene
+            .insert_primitive(BackdropBlurPrimitive {
+                order: 0,
+                blur_radius: blur.blur_radius.max(px(0.0)).scale(scale_factor),
+                noise: blur.noise.clamp(0.0, 1.0),
+                _pad: 0,
+                bounds: self.snap_bounds(blur.bounds),
+                content_mask: self.snapped_content_mask(),
+                tint: blur.tint.opacity(self.element_opacity()),
+                corner_radii: blur.corner_radii.scale(scale_factor),
+            });
+    }
