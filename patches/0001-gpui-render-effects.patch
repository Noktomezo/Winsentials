+/// Number of `float4` slots available to a GPU canvas shader.
+pub const GPU_CANVAS_UNIFORM_SLOTS: usize = 16;
+
+/// Runtime-compiled HLSL program used by a GPU canvas.
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct GpuCanvasShader {
+    name: &'static str,
+    source: &'static str,
+}
+
+impl GpuCanvasShader {
+    /// Creates a shader from HLSL source containing `gpu_canvas_vertex` and
+    /// `gpu_canvas_fragment` entry points.
+    pub const fn new(name: &'static str, source: &'static str) -> Self {
+        Self { name, source }
+    }
+
+    /// Human-readable shader name used in diagnostics and the pipeline cache.
+    pub const fn name(self) -> &'static str {
+        self.name
+    }
+
+    /// Complete HLSL source for the shader.
+    pub const fn source(self) -> &'static str {
+        self.source
+    }
+}
+
+/// Optional texture exposed to a GPU canvas at shader register `t0`.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[repr(u32)]
+pub enum GpuCanvasInput {
+    /// No input texture.
+    #[default]
+    None = 0,
+    /// A snapshot of the framebuffer rendered before this canvas.
+    Framebuffer = 1,
+}
+
+/// Fixed-size uniform payload exposed to HLSL as sixteen `float4` slots.
+#[derive(Clone, Copy, Debug, Default)]
+#[repr(C)]
+pub struct GpuCanvasUniforms {
+    /// User-defined shader data.
+    pub slots: [[f32; 4]; GPU_CANVAS_UNIFORM_SLOTS],
+}
+
+impl GpuCanvasUniforms {
+    /// Creates a uniform payload from sixteen `float4` slots.
+    pub const fn new(slots: [[f32; 4]; GPU_CANVAS_UNIFORM_SLOTS]) -> Self {
+        Self { slots }
+    }
+}
+
+/// GPU parameters shared by all runtime canvas shaders.
+#[derive(Default, Debug, Copy, Clone)]
+#[repr(C)]
