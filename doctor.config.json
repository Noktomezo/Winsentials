{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dev-dependency"]
      },
      {
        "files": ["src/pages/backup/ui/backup-dialogs.tsx"],
        "rules": ["react-doctor/no-many-boolean-props"]
      },
      {
        "files": ["src/widgets/titlebar/ui/app-titlebar.tsx"],
        "rules": ["react-doctor/no-static-element-interactions"]
      },
      {
        "files": [".github/workflows/release.yml"],
        "rules": ["react-doctor/build-pipeline-secret-boundary"]
      }
    ]
  }
}
